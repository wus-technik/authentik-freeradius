#  Copy to .env, or paste these into Portainer's stack environment variables.
#  Never commit a filled-in .env -- .gitignore excludes it.

#  --- images ---------------------------------------------------------------
#  Must match your authentik server version.
AUTHENTIK_VERSION=2026.2.1
#  Tag of ghcr.io/wus-technik/authentik-freeradius.
IMAGE_TAG=latest

#  --- authentik ------------------------------------------------------------
AUTHENTIK_HOST=https://auth.example.com
#  Outpost token from authentik.
AUTHENTIK_TOKEN=CHANGEME-outpost-token
#  Set true only if authentik uses a certificate the outpost cannot verify.
AUTHENTIK_INSECURE=false

#  --- RADIUS secrets -------------------------------------------------------
#  Between FreeRADIUS and the outpost. Must equal the shared secret configured
#  on the RADIUS provider in authentik. Generate with: openssl rand -hex 32
AUTHENTIK_RADIUS_SECRET=CHANGEME-run-openssl-rand-hex-32
#  Between the UniFi APs and FreeRADIUS, for every network in
#  RADIUS_CLIENT_NET that names no site. Enter this in the UniFi RADIUS
#  profile. Generate with: openssl rand -hex 32
RADIUS_SECRET=CHANGEME-run-openssl-rand-hex-32
#  One secret per site instead, as site:secret,site:secret. A site is a name
#  of 1-32 of A-Z a-z 0-9 _; a secret must not contain a comma. Each site's
#  UniFi RADIUS profile gets that site's secret (docs/unifi.md).
#  Example: RADIUS_SITE_SECRETS=hq:<openssl rand -hex 32>,branch:<...>
RADIUS_SITE_SECRETS=

#  --- network --------------------------------------------------------------
#  Networks of the APs allowed to send requests, comma separated. Never
#  0.0.0.0/0, and as narrow as the AP subnets allow. net=site uses that site's
#  secret from RADIUS_SITE_SECRETS, a bare net uses RADIUS_SECRET.
#  Example: RADIUS_CLIENT_NET=10.1.0.0/24=hq,10.1.1.0/24=hq,10.2.0.0/24=branch
RADIUS_CLIENT_NET=10.0.0.0/24
#  Bind address for the published UDP port. Where possible, bind to a
#  specific management/AP-facing interface address instead of 0.0.0.0.
RADIUS_LISTEN_ADDR=0.0.0.0

#  --- internal network -----------------------------------------------------
#  The private network between FreeRADIUS and the authentik outposts. Each
#  outpost has a fixed address in it, so nothing depends on DNS (issue #15).
#  Change the subnet only if it collides with a network on the host or LAN;
#  the addresses below must lie inside it but outside RADIUS_NET_DYNAMIC.
RADIUS_NET_SUBNET=172.31.253.0/24
RADIUS_NET_DYNAMIC=172.31.253.128/25
AUTHENTIK_RADIUS_IP=172.31.253.10
AUTHENTIK_LDAP_IP=172.31.253.11

#  --- dynamic VLAN ---------------------------------------------------------
#  Filter-Id names returned by an authentik property mapping, and the VLAN
#  each one means. Space or comma separated. Empty disables dynamic VLAN.
#  Example: VLAN_MAP=vlan-staff=20,vlan-devices=30
VLAN_MAP=

#  --- usernames ------------------------------------------------------------
#  true: "jdoe@any.domain" logs in as "jdoe", whatever the domain. Only for
#  directories where a username is unique across all domains (issue #8).
USERNAME_STRIP_DOMAIN=false
#  true: "ANYDOMAIN\jdoe" logs in as "jdoe" -- what Windows fills in on
#  domain-joined machines. Same caveat.
USERNAME_STRIP_NTDOMAIN=false

#  --- TLS ------------------------------------------------------------------
#  Host directory mounted read-only at /etc/letsencrypt in the container.
LETSENCRYPT_DIR=/etc/letsencrypt
#  CONTAINER paths, i.e. under /etc/letsencrypt.
TLS_CERT_PATH=/etc/letsencrypt/live/radius.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/radius.example.com/privkey.pem
#  Restart the container when the certificate changes, so renewals take
#  effect. Costs a few seconds of authentication downtime per renewal.
CERT_RELOAD_WATCH=true
CERT_RELOAD_INTERVAL=3600

#  --- PEAP (docker-compose.peap.yml only) -----------------------------------
#  Token of the LDAP outpost "wlan-ldap" in authentik.
AUTHENTIK_LDAP_TOKEN=CHANGEME-ldap-outpost-token
#  Base DN of the wlan-ldap provider, and the DNs FreeRADIUS needs. Each 1-255
#  characters of A-Z a-z 0-9 = , . _ - and spaces, nothing else (no + # ( )
#  or non-ASCII).
LDAP_BASE_DN=dc=ldap,dc=goauthentik,dc=io
LDAP_BIND_DN=cn=svc-wlan-ldap,ou=users,dc=ldap,dc=goauthentik,dc=io
#  Token of the service account svc-wlan-ldap (Directory > Tokens).
LDAP_BIND_PASSWORD=CHANGEME-service-account-token
LDAP_WLAN_GROUP_DN=cn=wlan,ou=groups,dc=ldap,dc=goauthentik,dc=io

#  --- debugging ------------------------------------------------------------
#  DEVELOPMENT ONLY. -X logs the inner tunnel, including cleartext passwords.
FREERADIUS_ENABLE_DEBUG=false
