server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    authorize {
        filter_username
        eap {
            ok = return
        }
    }

    authenticate {
        Auth-Type eap {
            eap
        }
    }

    # Handle proxy responses for the outer EAP session
    post-proxy {
        eap
    }

    post-auth {
        eap

        Post-Auth-Type REJECT {
            eap
        }
    }
}
