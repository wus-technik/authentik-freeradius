server default {
    listen {
        type = auth
        ipaddr = *
        port = 0
    }

    authorize {
        filter_username

        #  Status-Server on this socket is the container healthcheck. It must
        #  be answered explicitly: once any virtual server defines an
        #  "Autz-Type Status-Server" section -- sites-enabled/status does --
        #  the core stops replying Access-Accept by default and runs this
        #  section instead, which otherwise falls through to Access-Reject.
        #  Verified: removing this block turns the healthcheck permanently
        #  unhealthy while authentication still works.
        Autz-Type Status-Server {
            ok
        }

        eap {
            ok = return
        }
    }

    authenticate {
        Auth-Type eap {
            eap
        }
    }

    # Handle proxy responses for the outer EAP session
    post-proxy {
        eap
    }

    post-auth {
        eap

        Post-Auth-Type REJECT {
            eap
        }
    }
}
