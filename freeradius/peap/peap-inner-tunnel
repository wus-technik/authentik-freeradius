#  PEAP-MSCHAPv2: the NT hash comes from authentik via the LDAP outpost.
#  Verified against authentik 2026.8.3 (spec 6.4).
server peap-inner-tunnel {
	authorize {
		#  The EAP-Identity round needs nothing else.
		inner-eap {
			ok = return
		}
		#  Only the LDAP lookup uses the stripped name; mschap needs User-Name
		#  as the client sent it.
		username_strip_domain
		#  notfound: inactive, not in the WLAN group, or no WiFi password.
		#  fail (LDAP unreachable) already ends in a reject.
		ldap
		if (notfound) {
			peap_log_notfound
			reject
		}
		pap
	}

	authenticate {
		#  The instance name is the Auth-Type; "Auth-Type eap" makes radiusd
		#  refuse to start.
		Auth-Type inner-eap {
			inner-eap
		}
		#  eap_mschapv2 calls "Auth-Type mschap"; the section must carry that
		#  name. "Auth-Type MS-CHAP" alone rejects every password. reject = 1
		#  lets the section go on to log the refusal instead of returning.
		Auth-Type mschap {
			mschap {
				reject = 1
			}
			if (reject) {
				peap_log_badpass
				reject
			}
		}
	}
}
